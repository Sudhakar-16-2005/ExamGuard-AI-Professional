SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# PostgreSQL. Leave blank only if you intentionally want the SQLite development fallback.
DATABASE_URL=postgresql://examguard:change-this-password@127.0.0.1:5432/examguard

OCR_ENGINE=auto
OCR_LANGUAGES=eng
MATCH_REVIEW_THRESHOLD=0.55
MATCH_CRITICAL_THRESHOLD=0.78
MAX_UPLOAD_BYTES=20971520
MONITOR_MAX_BYTES=10485760
MONITOR_USER_AGENT=ExamGuardAI/1.0 (+authorized-security-monitor)

# Telegram Bot API: bot must be added to each monitored channel/group with appropriate permission.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Telegram MTProto: use only for public channels or channels explicitly authorized to this client.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=examguard_monitor
SITE_BASE_URL=http://127.0.0.1:8000

# WhatsApp Business Cloud API: receives messages sent to your business number; not private group surveillance.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
